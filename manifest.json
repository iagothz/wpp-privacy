{
  "manifest_version": 3,
  "name": "WPP Privacy",
  "short_name": "WPP Privacy",
  "version": "0.1.0",
  "description": "Privacidade no WhatsApp Web: borra mensagens, prévias, nomes e fotos até você passar o mouse.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "WPP Privacy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-privacy": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Liga/desliga o blur"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
